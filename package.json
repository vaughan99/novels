{
  "name": "@novels/compiler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Novel compiler for Obsidian manuscripts.",
  "scripts": {
    "build": "node compiler/src/build.mjs",
    "build-cynn": "npm run build -- \"The Cynn - Strangers To Wyrd\" && npm run split-md -- \"./build/The Cynn - Strangers To Wyrd/novel.md\" 4",
    "build-all": "npm run clean && npm run build-cynn && npm run generate-novel-index",
    "clean": "rm -fr ./build/*",
    "deploy": "npx gh-pages -d ./build --nojekyll",
    "generate-novel-index": "node compiler/src/generate-novel-index.mjs",
    "split-md": "node compiler/src/split-md-file.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "github-slugger": "^2.0.0"
  }
}
