<!DOCTYPE html>
<html
  xmlns="http://www.w3.org/1999/xhtml"
  lang="$if(lang)$$lang$$else$en-US$endif$"
  xml:lang="$if(lang)$$lang$$else$en-US$endif$"
  $if(dir)$dir="$dir$"$endif$
>
<head>
  <meta charset="utf-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, viewport-fit=cover"
  >

  $if(title)$
  <title>$title$$if(subtitle)$: $subtitle$$endif$</title>
  $else$
  <title>Untitled</title>
  $endif$

  $if(author)$
  <meta
    name="author"
    content="$for(author)$$author$$sep$, $endfor$"
  >
  $endif$

  $if(rights)$
  <meta name="copyright" content="$rights$">
  $endif$

  $if(build-timestamp)$
  <meta name="build-time" content="$build-timestamp$">
  $endif$

  $if(build-commit)$
  <meta name="build-commit" content="$build-commit$">
  $endif$

  $if(date-meta)$
  <meta name="dcterms.date" content="$date-meta$">
  $endif$

  $if(description-meta)$
  <meta name="description" content="$description-meta$">
  $endif$

  $if(keywords)$
  <meta
    name="keywords"
    content="$for(keywords)$$keywords$$sep$, $endfor$"
  >
  $endif$

  $if(base-url)$
  <base href="$base-url$">
  $endif$

  $for(css)$
  <link rel="stylesheet" href="$css$">
  $endfor$

  $for(header-includes)$
  $header-includes$
  $endfor$
</head>

<body>
  $for(include-before)$
  $include-before$
  $endfor$

  <div class="book-layout">

    <aside class="book-sidebar" aria-label="Book navigation">
      <div class="book-identity">
        $if(title)$
        <div class="book-title">$title$</div>
        $endif$

        $if(subtitle)$
        <div class="book-subtitle">$subtitle$</div>
        $endif$

        $if(author)$
        <div class="book-author">
          $for(author)$
          <span class="author">$author$</span>$sep$<span class="author-separator">, </span>
          $endfor$
        </div>
        $endif$

        $if(rights)$
        <div class="book-rights">$rights$</div>
        $endif$

        $if(build-timestamp)$
        <div class="book-build">
          <div class="book-build-label">Build</div>
          <time class="book-build-time">$build-timestamp$</time>
          $if(build-commit)$
          <div class="book-build-commit">
            Revision $build-commit$
          </div>
          $endif$
        </div>
        $endif$
      </div>

      $if(toc)$
      <nav
        id="$idprefix$TOC"
        class="book-toc"
        role="doc-toc"
        aria-labelledby="$idprefix$toc-title"
      >
        <h2 id="$idprefix$toc-title" class="toc-title">
          $if(toc-title)$$toc-title$$else$Contents$endif$
        </h2>

        $table-of-contents$
      </nav>
      $endif$
    </aside>

    <main
      id="main-content"
      class="book-content"
      role="main"
    >
      $if(title-block)$
      <header id="title-block-header" class="title-block">
        $if(title)$
        <h1 class="title">$title$</h1>
        $endif$

        $if(subtitle)$
        <p class="subtitle">$subtitle$</p>
        $endif$

        $if(author)$
        <p class="author">
          $for(author)$$author$$sep$, $endfor$
        </p>
        $endif$

        $if(date)$
        <p class="date">$date$</p>
        $endif$
      </header>
      $endif$

      $body$
    </main>

  </div>

  $for(include-after)$
  $include-after$
  $endfor$
</body>
</html>